#!/usr/bin/env bash
set -euo pipefail

# Resolve npm-link symlinks without changing the caller's working directory.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIRECTORY="$(CDPATH= cd -P -- "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$DIRECTORY/$SOURCE"
done
DIRECTORY="$(CDPATH= cd -P -- "$(dirname "$SOURCE")" && pwd)"
EXTENSION="$DIRECTORY/../src/extension.ts"
if [[ ! -f "$EXTENSION" || ! -r "$EXTENSION" ]]; then
  printf '%s\n' "Weavra: extension not found or unreadable at $EXTENSION. Keep the repository checkout intact and run npm link --workspace packages/company-runtime --ignore-scripts again." >&2
  exit 1
fi
EXTENSION="$(CDPATH= cd -P -- "$DIRECTORY/../src" && pwd)/extension.ts"
CHECKOUT="$(CDPATH= cd -P -- "$DIRECTORY/../../.." && pwd)"
# Keep the CLI and Extension tied to the same checkout, never a PATH-selected Pi.
PI="$CHECKOUT/packages/coding-agent/dist/bundle/cli.js"
if [[ ! -f "$PI" || ! -r "$PI" || ! -x "$PI" ]]; then
  printf 'Weavra: fork-local Pi build is missing or not executable: %s\nBuild from this checkout: cd %q && npm install --ignore-scripts && npm run build\nNo global Pi fallback.\n' "$PI" "$CHECKOUT" >&2
  exit 1
fi

# No shell re-parsing, cwd/env changes, extra process, or intercepted Pi flags.
exec "$PI" -e "$EXTENSION" "$@"
